# Copy to .env.local for local dev. Real values go in Vercel → Settings →
# Environment Variables — never commit actual secrets to this repo.

TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

SQUARE_ACCESS_TOKEN=
SQUARE_LOCATION_ID=
SQUARE_ENVIRONMENT=sandbox
SQUARE_WEBHOOK_SIGNATURE_KEY=

# Public — safe to expose client-side, used by the Web Payments SDK
NEXT_PUBLIC_SQUARE_APPLICATION_ID=
NEXT_PUBLIC_SQUARE_LOCATION_ID=
NEXT_PUBLIC_SQUARE_ENVIRONMENT=sandbox

RESEND_API_KEY=
RESEND_FROM_EMAIL=orders@liquidgoldskinco.com
RESEND_TO_EMAIL=liquidgoldskinco@gmail.com

AYRSHARE_API_KEY=
AYRSHARE_PROFILE_KEY=

NEXT_PUBLIC_SITE_URL=https://liquidgoldskinco.com
ADMIN_PASSWORD=

# Vercel Blob — for image uploads from the admin content editor. Enable
# Blob storage in the Vercel dashboard (Storage tab) and it provisions
# this automatically; you don't create it by hand.
BLOB_READ_WRITE_TOKEN=

# Flat-rate estimate only — NOT the legally accurate destination-based LA
# rate. See comment in src/app/api/checkout/route.ts before relying on this.
TAX_RATE_LA=0.05
